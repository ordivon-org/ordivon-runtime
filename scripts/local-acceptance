#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: scripts/local-acceptance check|run

check  validate that the local-only acceptance contract is present
run    execute real systemd/cgroup tests and MCP end-to-end acceptance

Set ORDIVON_ACCEPTANCE_OUTPUT to write the MCP journey receipt to an explicit path.
EOF
}

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
python_bin=${PYTHON_BIN:-python3}
mode=${1:-}
case "$mode" in
  check)
    test -f "$repo/crates/ordivon-runtime-core/tests/systemd_supervisor.rs"
    test -f "$repo/crates/ordivon-runtime-core/tests/transactional_runtime.rs"
    test -f "$repo/scripts/mcp_e2e.py"
    test -f "$repo/scripts/mcp_probe.py"
    test -f "$repo/scripts/check_docs.py"
    test -f "$repo/crates/ordivon-runtime-core/src/bin/ordivon-runtime-inspect.rs"
    test -x "$repo/scripts/ordivon-runtime-lifecycle"
    test -x "$repo/scripts/ordivon-runtime-status"
    test -x "$repo/scripts/ordivon-runtime-capacity-acceptance"
    test -f "$repo/packaging/systemd/ordivon-runtime-lifecycle.service"
    test -f "$repo/packaging/systemd/ordivon-runtime-lifecycle.timer"
    test -f "$repo/packaging/systemd/ordivon-workspace-retention.json"
    grep -q 'requires root, systemd, cgroup v2' "$repo/crates/ordivon-runtime-core/tests/systemd_supervisor.rs"
    grep -q 'requires root, systemd, cgroup v2' "$repo/crates/ordivon-runtime-core/tests/transactional_runtime.rs"
    "$python_bin" "$repo/scripts/check_docs.py"
    printf '%s\n' \
      'local acceptance contract: present' \
      'run with: scripts/local-acceptance run'
    ;;
  run)
    if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
      echo 'local acceptance requires root' >&2
      exit 1
    fi
    command -v systemctl >/dev/null
    command -v systemd-run >/dev/null
    test -f /sys/fs/cgroup/cgroup.controllers
    cd "$repo"
    "$python_bin" scripts/check_docs.py
    acceptance_target_dir=$(mktemp -d "${TMPDIR:-/tmp}/ordivon-local-acceptance-target.XXXXXX")
    trap 'rm -rf "$acceptance_target_dir"' EXIT
    export CARGO_TARGET_DIR="$acceptance_target_dir"
    cargo build -p ordivon-runtime-core --bin ordivon-runtime-runner
    target_dir=$(cargo metadata --no-deps --format-version 1 | "$python_bin" -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])')
    export ORDIVON_RUN_SYSTEMD_SPIKE=1
    export ORDIVON_RUN_INTEGRATION=1
    export ORDIVON_RUNNER_PATH="$target_dir/debug/ordivon-runtime-runner"
    test -x "$ORDIVON_RUNNER_PATH"
    cargo test -p ordivon-runtime-core --features systemd-supervisor \
      --test systemd_supervisor -- --ignored --test-threads=1 --nocapture
    cargo test -p ordivon-runtime-core --test transactional_runtime -- \
      --ignored --test-threads=1 --nocapture
    output_args=()
    if [[ -n ${ORDIVON_ACCEPTANCE_OUTPUT:-} ]]; then
      mkdir -p "$(dirname "$ORDIVON_ACCEPTANCE_OUTPUT")"
      output_args=(--output "$ORDIVON_ACCEPTANCE_OUTPUT")
    fi
    "$python_bin" scripts/mcp_e2e.py --repo . "${output_args[@]}"
    ;;
  --help|-h)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
