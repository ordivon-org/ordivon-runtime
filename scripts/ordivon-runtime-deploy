#!/usr/bin/env python3
"""Transactional local deployment and rollback for one Ordivon Runtime release artifact set."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import math
import os
import re
import shutil
import sqlite3
import stat
import subprocess
import sys
import tempfile
import time
from contextlib import closing, contextmanager
from pathlib import Path
from urllib.parse import quote

from mcp_probe import load_bearer_token, load_environment_file, probe_catalog

SCHEMA_VERSION = 3
LEGACY_SCHEMA_VERSIONS = {1, 2}
WINDOWS_PROVIDER_CONTRACT = "windows_native_launcher_v2"
WINDOWS_PROVIDER_NAME = "ordivon-windows-job-launcher.exe"
WINDOWS_PROVIDER_SOURCE = Path("platform/windows/Ordivon.WindowsJobLauncher.cs")
DEFAULT_WINDOWS_CSC = Path("/mnt/c/Windows/Microsoft.NET/Framework64/v4.0.30319/csc.exe")
DEFAULT_BINARIES = (
    "ordivon-runtime",
    "ordivon-runtime-runner",
    "ordivon-runtime-doctor",
    "ordivon-runtime-inspect",
    "ordivon-runtime-repair",
)
DEFAULT_OPERATOR_ARTIFACTS = (
    ("ordivon-runtime-deploy", "scripts/ordivon-runtime-deploy", 0o755, "operator"),
    ("ordivon-runtime-lifecycle", "scripts/ordivon-runtime-lifecycle", 0o755, "operator"),
    ("ordivon-runtime-reclaim", "scripts/ordivon-runtime-reclaim", 0o755, "operator"),
    ("ordivon-runtime-cache", "scripts/ordivon-runtime-cache", 0o755, "operator"),
    ("ordivon-runtime-status", "scripts/ordivon-runtime-status", 0o755, "operator"),
    (
        "ordivon-runtime-capacity-acceptance",
        "scripts/ordivon-runtime-capacity-acceptance",
        0o755,
        "operator",
    ),
    ("mcp_probe.py", "scripts/mcp_probe.py", 0o644, "support"),
)
DEFAULT_REQUIRED_TOOLS = (
    "release.apply",
    "release.get",
    "runtime.describe",
    "workspace.content",
    "workspace.execPlan",
    "workspace.get",
    "workspace.list",
    "workspace.patch",
    "workspace.patch.get",
)
COMMIT_PATTERN = re.compile(r"^[0-9a-f]{40}$")
SHA256_PATTERN = re.compile(r"^sha256:[0-9a-f]{64}$")
RELEASE_EFFECT_ID_PATTERN = re.compile(r"^[0-9a-f]{64}$")
RELEASE_REQUEST_DIGEST_PATTERN = re.compile(r"^runtime-release-v1:sha256:[0-9a-f]{64}$")
ATTEMPT_UNIT_PATTERN = re.compile(r"/ordivon-(attempt-[^.\s/]+)\.service(?:$|/)")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="ordivon-runtime-deploy")
    subparsers = parser.add_subparsers(dest="command", required=True)

    prepare = subparsers.add_parser(
        "prepare", help="build one exact clean commit and write a digest-bound candidate manifest"
    )
    prepare.add_argument("--source-repo", type=absolute_path, required=True)
    prepare.add_argument("--commit", type=exact_commit, required=True)
    prepare.add_argument("--candidate-dir", type=absolute_path, required=True)
    prepare.add_argument("--candidate-manifest", type=absolute_path, required=True)
    prepare.add_argument("--cargo", type=absolute_path, required=True)
    prepare.add_argument("--windows-csc", type=absolute_path)
    prepare.add_argument("--binary", action="append", dest="binaries")
    prepare.add_argument("--pretty", action="store_true")

    plan = subparsers.add_parser("plan", help="validate a candidate deployment without mutation")
    add_deployment_arguments(plan, require_confirmation=False)
    plan.add_argument("--pretty", action="store_true")

    apply = subparsers.add_parser("apply", help="atomically drain admission, install, restart, probe, and receipt")
    add_deployment_arguments(apply, require_confirmation=True)
    apply.add_argument("--drain-seconds", type=positive_float, default=30.0)
    apply.add_argument("--effect-id", type=exact_release_effect_id)
    apply.add_argument("--effect-request-digest", type=exact_release_request_digest)
    apply.add_argument("--candidate-manifest-digest", type=exact_sha256_digest)

    rollback = subparsers.add_parser(
        "rollback", help="restore release artifacts retained by one deployment receipt"
    )
    rollback.add_argument("--receipt", type=absolute_path, required=True)
    rollback.add_argument("--install-dir", type=absolute_path, required=True)
    rollback.add_argument("--service", default="ordivon-runtime.service")
    rollback.add_argument("--env-file", type=absolute_path, required=True)
    rollback.add_argument("--database", type=absolute_path)
    rollback.add_argument("--systemctl", type=absolute_path, default=Path("/usr/bin/systemctl"))
    rollback.add_argument("--lock-file", type=absolute_path, default=Path("/run/ordivon-runtime-deploy.lock"))
    rollback.add_argument("--wait-seconds", type=positive_float, default=15.0)
    rollback.add_argument("--drain-seconds", type=positive_float, default=30.0)
    rollback.add_argument("--confirm-receipt", type=absolute_path, required=True)
    return parser.parse_args()


def add_deployment_arguments(parser: argparse.ArgumentParser, *, require_confirmation: bool) -> None:
    parser.add_argument("--source-repo", type=absolute_path, required=True)
    parser.add_argument("--commit", type=exact_commit, required=True)
    parser.add_argument("--candidate-dir", type=absolute_path, required=True)
    parser.add_argument("--candidate-manifest", type=absolute_path, required=True)
    parser.add_argument("--install-dir", type=absolute_path, required=True)
    parser.add_argument("--database", type=absolute_path, required=True)
    parser.add_argument("--env-file", type=absolute_path, required=True)
    parser.add_argument("--receipt-root", type=absolute_path, required=True)
    parser.add_argument("--service", default="ordivon-runtime.service")
    parser.add_argument("--systemctl", type=absolute_path, default=Path("/usr/bin/systemctl"))
    parser.add_argument("--git", type=absolute_path, default=Path("/usr/bin/git"))
    parser.add_argument("--lock-file", type=absolute_path, default=Path("/run/ordivon-runtime-deploy.lock"))
    parser.add_argument("--binary", action="append", dest="binaries")
    parser.add_argument("--required-tool", action="append", dest="required_tools")
    parser.add_argument("--expected-tool-count", type=nonnegative_int)
    parser.add_argument("--require-ref", default="origin/main")
    parser.add_argument("--wait-seconds", type=positive_float, default=15.0)
    if require_confirmation:
        parser.add_argument("--confirm-commit", type=exact_commit, required=True)


def absolute_path(value: str) -> Path:
    path = Path(value)
    if not path.is_absolute():
        raise argparse.ArgumentTypeError("path must be absolute")
    return path


def exact_commit(value: str) -> str:
    if not COMMIT_PATTERN.fullmatch(value):
        raise argparse.ArgumentTypeError("commit must be exactly 40 lowercase hexadecimal characters")
    return value


def exact_sha256_digest(value: str) -> str:
    if not SHA256_PATTERN.fullmatch(value):
        raise argparse.ArgumentTypeError("digest must be sha256 followed by 64 lowercase hexadecimal characters")
    return value


def exact_release_effect_id(value: str) -> str:
    if not RELEASE_EFFECT_ID_PATTERN.fullmatch(value):
        raise argparse.ArgumentTypeError("effect-id must be exactly 64 lowercase hexadecimal characters")
    return value


def exact_release_request_digest(value: str) -> str:
    if not RELEASE_REQUEST_DIGEST_PATTERN.fullmatch(value):
        raise argparse.ArgumentTypeError(
            "effect-request-digest must be runtime-release-v1:sha256:<64 lowercase hex>"
        )
    return value


def positive_float(value: str) -> float:
    parsed = float(value)
    if not math.isfinite(parsed) or parsed <= 0:
        raise argparse.ArgumentTypeError("value must be finite and positive")
    return parsed


def nonnegative_int(value: str) -> int:
    parsed = int(value)
    if parsed < 0:
        raise argparse.ArgumentTypeError("value must be nonnegative")
    return parsed


def binaries(args: argparse.Namespace) -> tuple[str, ...]:
    values = tuple(args.binaries or DEFAULT_BINARIES)
    if not values or len(values) != len(set(values)):
        raise RuntimeError("binary names must be nonempty and unique")
    for value in values:
        if value in {".", ".."} or "/" in value or chr(0) in value:
            raise RuntimeError(f"invalid binary name: {value}")
    return values


def release_artifact_specs(args: argparse.Namespace) -> tuple[dict[str, object], ...]:
    specs: list[dict[str, object]] = [
        {"name": name, "kind": "binary", "mode": 0o755} for name in binaries(args)
    ]
    # An explicit --binary list is an intentional subset mode used by tests and
    # exceptional maintenance. The default production release is the complete
    # Runtime executable/support artifact set.
    if args.binaries is None:
        specs.extend(
            {"name": name, "source": source, "mode": mode, "kind": kind}
            for name, source, mode, kind in DEFAULT_OPERATOR_ARTIFACTS
        )
    names = [str(spec["name"]) for spec in specs]
    if len(names) != len(set(names)):
        raise RuntimeError("release artifact names must be unique")
    return tuple(specs)


def stage_operator_artifacts(args: argparse.Namespace, source_root: Path) -> None:
    if args.binaries is not None:
        return
    for name, relative_source, mode, _kind in DEFAULT_OPERATOR_ARTIFACTS:
        source = source_root / relative_source
        if source.is_symlink() or not source.is_file():
            raise RuntimeError(f"release operator artifact is missing or unsafe: {source}")
        atomic_copy(source, args.candidate_dir / name, mode=mode)

def required_tools(args: argparse.Namespace) -> tuple[str, ...]:
    values = tuple(args.required_tools or DEFAULT_REQUIRED_TOOLS)
    if len(values) != len(set(values)) or any(not value.strip() for value in values):
        raise RuntimeError("required tool names must be nonempty and unique")
    return values


def run(
    command: list[str],
    *,
    check: bool = True,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        command, text=True, capture_output=True, check=False, cwd=cwd, env=env
    )
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise RuntimeError(f"command failed ({' '.join(command)}): {detail}")
    return result


def git_text(git: Path, repo: Path, arguments: list[str]) -> str:
    return run([str(git), "-C", str(repo), *arguments]).stdout.strip()


@contextmanager
def exact_source_checkout(source_repo: Path, commit: str):
    git = Path("/usr/bin/git")
    with tempfile.TemporaryDirectory(prefix="ordivon-runtime-release-source-") as temporary:
        checkout = Path(temporary) / "source"
        run(
            [
                str(git),
                "clone",
                "--quiet",
                "--shared",
                "--no-checkout",
                str(source_repo),
                str(checkout),
            ]
        )
        run([str(git), "-C", str(checkout), "checkout", "--quiet", "--detach", commit])
        head = git_text(git, checkout, ["rev-parse", "HEAD"])
        if head != commit:
            raise RuntimeError(
                f"detached release source resolved to {head} instead of requested commit {commit}"
            )
        status = git_text(git, checkout, ["status", "--porcelain", "--untracked-files=all"])
        if status:
            raise RuntimeError("detached release source is not clean after exact checkout")
        yield checkout


def executable_identity(path: Path) -> dict[str, object]:
    resolved = path.resolve(strict=True)
    if resolved.is_symlink() or not resolved.is_file() or not os.access(resolved, os.X_OK):
        raise RuntimeError(f"toolchain executable is missing or unsafe: {path}")
    version = run([str(path), "--version", "--verbose"]).stdout.strip().splitlines()
    if not version:
        raise RuntimeError(f"toolchain executable returned no version: {path}")
    return {
        "path": str(path),
        "resolvedPath": str(resolved),
        "digest": sha256(resolved),
        "version": version[0],
        "details": version[1:],
    }


def build_toolchain_identity(cargo: Path) -> dict[str, object]:
    rustc = cargo.with_name("rustc")
    if not rustc.is_file() or not os.access(rustc, os.X_OK):
        raise RuntimeError("release Cargo must have an executable sibling rustc")
    cargo_identity = executable_identity(cargo)
    rustc_identity = executable_identity(rustc)
    host = None
    for line in rustc_identity["details"]:
        if isinstance(line, str) and line.startswith("host: "):
            host = line.removeprefix("host: ")
            break
    if not host:
        raise RuntimeError("rustc --version --verbose omitted host target")
    return {
        "cargo": cargo_identity,
        "rustc": rustc_identity,
        "host": host,
    }


def current_attempt_id() -> str | None:
    try:
        cgroup = Path("/proc/self/cgroup").read_text(encoding="utf-8")
    except OSError:
        return None
    match = ATTEMPT_UNIT_PATTERN.search(cgroup)
    return match.group(1) if match else None


def active_job_ids(database: Path) -> tuple[list[str], str | None]:
    uri = f"file:{quote(str(database))}?mode=ro"
    with closing(sqlite3.connect(uri, uri=True, timeout=5)) as connection:
        connection.execute("PRAGMA query_only=ON")
        connection.execute("PRAGMA trusted_schema=OFF")
        required = {
            "jobs": {"job_id", "resolution"},
            "attempts": {"attempt_id", "job_id"},
            "concurrency_reservations": {"attempt_id", "state"},
        }
        for table, columns in required.items():
            present = {str(row[1]) for row in connection.execute(f"PRAGMA table_info({table})")}
            missing = columns - present
            if missing:
                raise RuntimeError(
                    "Runtime Registry lacks deployment capabilities: "
                    + ", ".join(f"{table}.{column}" for column in sorted(missing))
                )
        attempt_id = current_attempt_id()
        current_job_id = None
        if attempt_id is not None:
            row = connection.execute(
                "SELECT job_id FROM attempts WHERE attempt_id=?",
                (attempt_id,),
            ).fetchone()
            current_job_id = str(row[0]) if row is not None else None
        rows = connection.execute(
            """
            SELECT DISTINCT jobs.job_id
            FROM jobs
            LEFT JOIN attempts ON attempts.job_id=jobs.job_id
            LEFT JOIN concurrency_reservations
              ON concurrency_reservations.attempt_id=attempts.attempt_id
            WHERE jobs.resolution IS NULL
               OR concurrency_reservations.state IN ('active','held_orphaned')
            ORDER BY jobs.job_id
            LIMIT 100
            """
        ).fetchall()
    jobs = [str(row[0]) for row in rows]
    if current_job_id is not None:
        jobs = [job_id for job_id in jobs if job_id != current_job_id]
    return jobs, current_job_id


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return "sha256:" + digest.hexdigest()


def release_artifact_fingerprint(records: object) -> dict[str, tuple[str, int]] | None:
    if not isinstance(records, list) or not records:
        return None
    fingerprint: dict[str, tuple[str, int]] = {}
    for item in records:
        if not isinstance(item, dict):
            return None
        name = item.get("name")
        digest = item.get("digest")
        mode = item.get("mode")
        kind = item.get("kind") if isinstance(item.get("kind"), str) else "binary"
        if not isinstance(name, str) or not isinstance(digest, str):
            return None
        if mode is None and kind == "binary":
            mode = 0o755
        if not isinstance(mode, int) or name in fingerprint:
            return None
        fingerprint[name] = (digest, mode)
    return fingerprint


def matching_release_commit(
    deployment_root: Path, installed_records: object
) -> str | None:
    target = release_artifact_fingerprint(installed_records)
    if target is None or not deployment_root.is_dir():
        return None
    candidates: list[tuple[int, str]] = []
    for pattern, valid_status in (
        ("*/result.json", "deployed"),
        ("*/rollback-result.json", "restored_previous"),
    ):
        for path in deployment_root.glob(pattern):
            try:
                event = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            if not isinstance(event, dict) or event.get("status") != valid_status:
                continue
            commit = event.get("commit")
            finished = event.get("finishedAtMs")
            if (
                not isinstance(commit, str)
                or not COMMIT_PATTERN.fullmatch(commit)
                or not isinstance(finished, int)
                or finished < 0
            ):
                continue
            if release_artifact_fingerprint(event.get("installed")) == target:
                candidates.append((finished, commit))
    return max(candidates)[1] if candidates else None


def artifact_description(
    path: Path,
    spec: dict[str, object],
    *,
    enforce_mode: bool = True,
) -> dict[str, object]:
    if path.is_symlink() or not path.is_file():
        raise RuntimeError(f"release artifact is missing or unsafe: {path}")
    name = str(spec["name"])
    kind = str(spec.get("kind", "binary"))
    expected_mode = int(spec.get("mode", 0o755))
    observed_mode = stat.S_IMODE(path.stat().st_mode)
    if enforce_mode and observed_mode != expected_mode:
        raise RuntimeError(
            f"release artifact mode mismatch for {name}: "
            f"expected {expected_mode:#05o}, observed {observed_mode:#05o}"
        )
    if enforce_mode and expected_mode & 0o111 and not os.access(path, os.X_OK):
        raise RuntimeError(f"release artifact is not executable: {path}")
    return {
        "name": name,
        "kind": kind,
        "mode": observed_mode,
        "path": str(path),
        "bytes": path.stat().st_size,
        "digest": sha256(path),
    }


def binary_description(path: Path, name: str) -> dict[str, object]:
    # Compatibility helper for focused binary-only tests and older callers.
    return artifact_description(
        path, {"name": name, "kind": "binary", "mode": 0o755}, enforce_mode=True
    )


def candidate_artifacts(args: argparse.Namespace) -> list[dict[str, object]]:
    return [
        artifact_description(args.candidate_dir / str(spec["name"]), spec)
        for spec in release_artifact_specs(args)
    ]

def windows_path(path: Path) -> str:
    result = run(["/usr/bin/wslpath", "-w", str(path.resolve())])
    value = result.stdout.strip()
    if not value:
        raise RuntimeError(f"cannot project Windows path: {path}")
    return value


def prepare_windows_provider(
    args: argparse.Namespace, build_source: Path
) -> dict[str, object] | None:
    source = build_source / WINDOWS_PROVIDER_SOURCE
    if not source.is_file() or source.is_symlink():
        return None
    compiler = args.windows_csc
    if compiler is None and DEFAULT_WINDOWS_CSC.is_file():
        compiler = DEFAULT_WINDOWS_CSC
    if compiler is None:
        return None
    if compiler.is_symlink() or not compiler.is_file():
        raise RuntimeError(f"Windows provider compiler is missing or unsafe: {compiler}")
    candidate = args.candidate_dir / WINDOWS_PROVIDER_NAME
    candidate.parent.mkdir(parents=True, exist_ok=True)
    candidate.unlink(missing_ok=True)
    run(
        [
            str(compiler),
            "/nologo",
            "/optimize+",
            f"/out:{windows_path(candidate)}",
            windows_path(source),
        ]
    )
    if candidate.is_symlink() or not candidate.is_file():
        raise RuntimeError("Windows provider compiler did not produce the candidate launcher")
    candidate.chmod(0o755)
    context = run(
        [
            str(candidate),
            "--describe-runtime-context",
            "--authority",
            "limited",
            "--context-env",
            "Path",
        ]
    )
    try:
        described = json.loads(context.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError("candidate Windows launcher returned invalid runtime-context JSON") from error
    if described.get("providerContract") != WINDOWS_PROVIDER_CONTRACT:
        raise RuntimeError("candidate Windows launcher does not prove the required provider contract")
    record = artifact_description(
        candidate,
        {"name": WINDOWS_PROVIDER_NAME, "kind": "windows_provider", "mode": 0o755},
    )
    record.update(
        {
            "contract": WINDOWS_PROVIDER_CONTRACT,
            "source": str(WINDOWS_PROVIDER_SOURCE),
            "sourceDigest": sha256(source),
            "compiler": {
                "path": str(compiler),
                "resolvedPath": str(compiler.resolve()),
                "digest": sha256(compiler.resolve()),
            },
        }
    )
    return record


def env_assignment_rewrite(
    env_file: Path, name: str, expected_value: str, new_value: str
) -> tuple[bytes, str, str]:
    raw = env_file.read_bytes()
    before = "sha256:" + hashlib.sha256(raw).hexdigest()
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise RuntimeError("Runtime environment file must be UTF-8") from error
    lines = text.splitlines(keepends=True)
    prefix = name + "="
    matches = [index for index, line in enumerate(lines) if line.startswith(prefix)]
    if len(matches) != 1:
        raise RuntimeError(f"environment file must contain exactly one {name} assignment")
    index = matches[0]
    line = lines[index]
    newline = "\r\n" if line.endswith("\r\n") else ("\n" if line.endswith("\n") else "")
    observed = line[len(prefix) : len(line) - len(newline) if newline else None]
    if observed != expected_value:
        raise RuntimeError(
            f"{name} changed: expected {expected_value}, observed {observed}"
        )
    lines[index] = prefix + new_value + newline
    updated = "".join(lines).encode("utf-8")
    after = "sha256:" + hashlib.sha256(updated).hexdigest()
    return updated, before, after


def atomic_write_bytes(path: Path, data: bytes, *, expected_digest: str) -> None:
    if path.is_symlink() or not path.is_file():
        raise RuntimeError(f"file is missing or unsafe: {path}")
    if sha256(path) != expected_digest:
        raise RuntimeError(f"file changed before atomic update: {path}")
    mode = stat.S_IMODE(path.stat().st_mode)
    temporary = path.with_name(path.name + f".tmp-{os.getpid()}")
    try:
        with temporary.open("xb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
        parent_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(parent_fd)
        finally:
            os.close(parent_fd)
    finally:
        temporary.unlink(missing_ok=True)


def candidate_windows_provider(
    args: argparse.Namespace, manifest: dict[str, object], blockers: list[str]
) -> dict[str, object] | None:
    raw = manifest.get("windowsProvider")
    if raw is None:
        return None
    if not isinstance(raw, dict):
        blockers.append("candidate manifest Windows provider record is invalid")
        return None
    name = raw.get("name")
    if name != WINDOWS_PROVIDER_NAME or raw.get("contract") != WINDOWS_PROVIDER_CONTRACT:
        blockers.append("candidate manifest Windows provider contract is unsupported")
        return raw
    try:
        observed = artifact_description(
            args.candidate_dir / WINDOWS_PROVIDER_NAME,
            {"name": WINDOWS_PROVIDER_NAME, "kind": "windows_provider", "mode": 0o755},
        )
    except RuntimeError as error:
        blockers.append(str(error))
        return raw
    for field in ("digest", "bytes", "mode", "kind"):
        if raw.get(field) != observed.get(field):
            blockers.append("candidate Windows provider does not match manifest")
            break
    if not isinstance(raw.get("sourceDigest"), str) or not SHA256_PATTERN.fullmatch(str(raw.get("sourceDigest"))):
        blockers.append("candidate Windows provider lacks source digest")
    compiler = raw.get("compiler")
    if (
        not isinstance(compiler, dict)
        or not isinstance(compiler.get("resolvedPath"), str)
        or not isinstance(compiler.get("digest"), str)
        or not SHA256_PATTERN.fullmatch(str(compiler.get("digest")))
    ):
        blockers.append("candidate Windows provider lacks compiler identity")
    return raw


def planned_windows_provider(
    args: argparse.Namespace, candidate_provider: dict[str, object] | None
) -> tuple[dict[str, object], list[str]]:
    environment = load_environment_file(args.env_file)
    launcher_value = environment.get("ORDIVON_WINDOWS_LAUNCHER_PATH")
    distribution = environment.get("ORDIVON_WINDOWS_WSL_DISTRIBUTION")
    blockers: list[str] = []
    if bool(launcher_value) != bool(distribution):
        blockers.append("Windows provider configuration is incomplete")
    if not launcher_value:
        return {"configured": False, "candidate": candidate_provider}, blockers
    if candidate_provider is None:
        blockers.append("configured Windows provider requires a candidate launcher")
        return {"configured": True, "currentPath": launcher_value, "candidate": None}, blockers
    current = Path(launcher_value)
    if not current.is_absolute() or current.is_symlink() or not current.is_file():
        blockers.append("configured Windows launcher path is missing or unsafe")
        return {"configured": True, "currentPath": launcher_value, "candidate": candidate_provider}, blockers
    if current.name != WINDOWS_PROVIDER_NAME or len(current.parents) < 2:
        blockers.append("configured Windows launcher path has unsupported layout")
        return {"configured": True, "currentPath": launcher_value, "candidate": candidate_provider}, blockers
    provider_root = current.parent.parent
    if provider_root.is_symlink() or not provider_root.is_dir():
        blockers.append("configured Windows launcher provider root is unsafe")
    digest = str(candidate_provider.get("digest", ""))
    if not SHA256_PATTERN.fullmatch(digest):
        blockers.append("candidate Windows provider digest is invalid")
        return {"configured": True, "currentPath": launcher_value, "candidate": candidate_provider}, blockers
    target = provider_root / f"sha256-{digest.removeprefix('sha256:')}" / WINDOWS_PROVIDER_NAME
    try:
        updated, env_before, env_after = env_assignment_rewrite(
            args.env_file, "ORDIVON_WINDOWS_LAUNCHER_PATH", launcher_value, str(target)
        )
        del updated
    except RuntimeError as error:
        blockers.append(str(error))
        env_before = sha256(args.env_file) if args.env_file.is_file() else None
        env_after = None
    return {
        "configured": True,
        "contract": WINDOWS_PROVIDER_CONTRACT,
        "currentPath": launcher_value,
        "currentDigest": sha256(current),
        "providerRoot": str(provider_root),
        "candidate": candidate_provider,
        "deployedPath": str(target),
        "envBeforeDigest": env_before,
        "envAfterDigest": env_after,
    }, blockers


def install_windows_provider(
    args: argparse.Namespace, record: dict[str, object] | None
) -> dict[str, object] | None:
    if not isinstance(record, dict) or record.get("configured") is not True:
        return None
    candidate = record.get("candidate")
    if not isinstance(candidate, dict):
        raise RuntimeError("deployment plan lacks Windows provider candidate")
    source = args.candidate_dir / WINDOWS_PROVIDER_NAME
    target = Path(str(record.get("deployedPath")))
    expected_digest = str(candidate.get("digest"))
    if not SHA256_PATTERN.fullmatch(expected_digest):
        raise RuntimeError("deployment plan has invalid Windows provider digest")
    target.parent.mkdir(parents=True, exist_ok=True)
    atomic_copy(source, target, mode=0o755)
    if sha256(target) != expected_digest:
        raise RuntimeError("installed Windows provider digest does not match candidate")
    previous_path = str(record.get("currentPath"))
    updated, before, after = env_assignment_rewrite(
        args.env_file, "ORDIVON_WINDOWS_LAUNCHER_PATH", previous_path, str(target)
    )
    if before != record.get("envBeforeDigest") or after != record.get("envAfterDigest"):
        raise RuntimeError("Runtime environment provider update no longer matches deployment plan")
    atomic_write_bytes(args.env_file, updated, expected_digest=before)
    return {
        **record,
        "installedDigest": sha256(target),
        "environmentDigest": sha256(args.env_file),
    }


def restore_windows_provider(
    env_file: Path, record: dict[str, object] | None
) -> dict[str, object] | None:
    if not isinstance(record, dict) or record.get("configured") is not True:
        return None
    previous = str(record.get("currentPath"))
    deployed = str(record.get("deployedPath"))
    before = str(record.get("envBeforeDigest"))
    after = str(record.get("envAfterDigest"))
    current_digest = sha256(env_file)
    if current_digest == before:
        return {"restored": False, "launcherPath": previous, "environmentDigest": before}
    if current_digest != after:
        raise RuntimeError("Runtime environment changed outside the deployment before provider rollback")
    updated, observed, restored = env_assignment_rewrite(
        env_file, "ORDIVON_WINDOWS_LAUNCHER_PATH", deployed, previous
    )
    if observed != after or restored != before:
        raise RuntimeError("Windows provider rollback does not reproduce the previous environment")
    atomic_write_bytes(env_file, updated, expected_digest=after)
    return {"restored": True, "launcherPath": previous, "environmentDigest": sha256(env_file)}


def inverse_windows_provider_record(record: dict[str, object] | None) -> dict[str, object] | None:
    if not isinstance(record, dict) or record.get("configured") is not True:
        return record
    return {
        **record,
        "currentPath": record.get("deployedPath"),
        "deployedPath": record.get("currentPath"),
        "envBeforeDigest": record.get("envAfterDigest"),
        "envAfterDigest": record.get("envBeforeDigest"),
    }


def prepare_candidate(args: argparse.Namespace) -> dict[str, object]:
    binary_names = binaries(args)
    if args.candidate_dir.name != "release":
        raise RuntimeError("candidate-dir must be the release directory under one Cargo target root")
    toolchain = build_toolchain_identity(args.cargo)
    # Preserve the invocation path for rustup-style proxy symlinks. The resolved
    # path remains digest-bound in the manifest, but invoking that resolved
    # binary directly would lose the proxy basename (rustc/rustdoc) semantics.
    rustc = Path(str(toolchain["rustc"]["path"]))
    build_env = os.environ.copy()
    build_env["RUSTC"] = str(rustc)
    rustdoc = args.cargo.with_name("rustdoc")
    if rustdoc.is_file() and os.access(rustdoc, os.X_OK):
        build_env["RUSTDOC"] = str(rustdoc)
    build_env["PATH"] = str(args.cargo.parent) + os.pathsep + build_env.get("PATH", "")
    windows_provider = None
    with exact_source_checkout(args.source_repo, args.commit) as build_source:
        stage_operator_artifacts(args, build_source)
        run(
            [
                str(args.cargo),
                "build",
                "--release",
                "--workspace",
                "--all-features",
                "--target-dir",
                str(args.candidate_dir.parent),
            ],
            cwd=build_source,
            env=build_env,
        )
        post_build_status = git_text(
            Path("/usr/bin/git"),
            build_source,
            ["status", "--porcelain", "--untracked-files=all"],
        )
        if post_build_status:
            raise RuntimeError("candidate build changed the detached release source")
        windows_provider = prepare_windows_provider(args, build_source)
    candidate = candidate_artifacts(args)
    binary_set = set(binary_names)
    manifest = {
        "schemaVersion": SCHEMA_VERSION,
        "commit": args.commit,
        "sourceRepo": str(args.source_repo.resolve()),
        "sourceMaterialization": "detached_git_checkout",
        "candidateDir": str(args.candidate_dir.resolve()),
        "builtAtMs": int(time.time() * 1000),
        "cargo": str(args.cargo),
        "toolchain": toolchain,
        "artifacts": candidate,
        "binaries": [item for item in candidate if str(item["name"]) in binary_set],
        "windowsProvider": windows_provider,
    }
    write_json_atomic(args.candidate_manifest, manifest)
    return {**manifest, "candidateManifest": str(args.candidate_manifest.resolve())}

def validate_candidate_manifest(
    args: argparse.Namespace, candidate: list[dict[str, object]]
) -> tuple[dict[str, object], list[str]]:
    manifest = json.loads(args.candidate_manifest.read_text(encoding="utf-8"))
    blockers: list[str] = []
    if manifest.get("schemaVersion") not in {2, SCHEMA_VERSION}:
        blockers.append("candidate manifest schemaVersion is unsupported")
    if manifest.get("commit") != args.commit:
        blockers.append("candidate manifest commit does not match requested commit")
    if Path(str(manifest.get("sourceRepo"))).resolve() != args.source_repo.resolve():
        blockers.append("candidate manifest source repository does not match source-repo")
    if Path(str(manifest.get("candidateDir"))).resolve() != args.candidate_dir.resolve():
        blockers.append("candidate manifest directory does not match candidate-dir")
    if manifest.get("sourceMaterialization") != "detached_git_checkout":
        blockers.append("candidate manifest source materialization is unsupported")
    toolchain = manifest.get("toolchain")
    if not isinstance(toolchain, dict):
        blockers.append("candidate manifest lacks build toolchain identity")
    else:
        for name in ("cargo", "rustc"):
            identity = toolchain.get(name)
            if (
                not isinstance(identity, dict)
                or not isinstance(identity.get("version"), str)
                or not isinstance(identity.get("resolvedPath"), str)
                or not isinstance(identity.get("digest"), str)
                or not str(identity.get("digest")).startswith("sha256:")
            ):
                blockers.append(f"candidate manifest has invalid {name} identity")
        if not isinstance(toolchain.get("host"), str) or not toolchain.get("host"):
            blockers.append("candidate manifest lacks Rust host target")
    manifest_by_name = {
        str(item.get("name")): item
        for item in manifest.get("artifacts", [])
        if isinstance(item, dict)
    }
    for item in candidate:
        name = str(item["name"])
        recorded = manifest_by_name.get(name)
        if recorded is None:
            blockers.append(f"candidate manifest lacks release artifact {name}")
            continue
        for field in ("digest", "bytes", "mode", "kind"):
            if recorded.get(field) != item.get(field):
                blockers.append(f"candidate release artifact does not match manifest: {name}")
                break
    candidate_names = {str(item["name"]) for item in candidate}
    if set(manifest_by_name) != candidate_names:
        blockers.append("candidate manifest artifact set does not match requested release set")
    manifest_binary_names = {
        str(item.get("name"))
        for item in manifest.get("binaries", [])
        if isinstance(item, dict)
    }
    expected_binary_names = {
        str(item["name"]) for item in candidate if item.get("kind") == "binary"
    }
    if manifest_binary_names != expected_binary_names:
        blockers.append("candidate manifest binary subset does not match release artifacts")
    windows_provider = candidate_windows_provider(args, manifest, blockers)
    observed_manifest_digest = sha256(args.candidate_manifest)
    expected_manifest_digest = getattr(args, "candidate_manifest_digest", None)
    if expected_manifest_digest is not None and observed_manifest_digest != expected_manifest_digest:
        blockers.append("candidate manifest digest does not match structured release request")
    summary = {
        "path": str(args.candidate_manifest.resolve()),
        "digest": observed_manifest_digest,
        "commit": manifest.get("commit"),
        "sourceRepo": manifest.get("sourceRepo"),
        "candidateDir": manifest.get("candidateDir"),
        "sourceMaterialization": manifest.get("sourceMaterialization"),
        "builtAtMs": manifest.get("builtAtMs"),
        "toolchain": toolchain,
        "artifactCount": len(manifest_by_name),
        "windowsProvider": windows_provider,
    }
    return summary, blockers

def deployment_plan(args: argparse.Namespace) -> dict[str, object]:
    specs = release_artifact_specs(args)
    head = git_text(args.git, args.source_repo, ["rev-parse", "HEAD"])
    status = git_text(args.git, args.source_repo, ["status", "--porcelain"])
    required_ref = git_text(args.git, args.source_repo, ["rev-parse", args.require_ref])
    jobs, ignored_current_job_id = active_job_ids(args.database)
    candidate = candidate_artifacts(args)
    candidate_manifest, manifest_blockers = validate_candidate_manifest(args, candidate)
    windows_provider, windows_provider_blockers = planned_windows_provider(
        args, candidate_manifest.get("windowsProvider") if isinstance(candidate_manifest, dict) else None
    )
    installed: list[dict[str, object]] = []
    for spec in specs:
        name = str(spec["name"])
        path = args.install_dir / name
        present = path.is_file() and not path.is_symlink()
        observed_mode = stat.S_IMODE(path.stat().st_mode) if present else None
        executable_required = bool(int(spec["mode"]) & 0o111)
        executable_ok = present and (not executable_required or os.access(path, os.X_OK))
        installed.append(
            {
                "name": name,
                "kind": str(spec["kind"]),
                "path": str(path),
                "present": present,
                "usable": executable_ok,
                "mode": observed_mode,
                "digest": sha256(path) if present else None,
                "bytes": path.stat().st_size if present else None,
            }
        )
    blockers: list[str] = [*manifest_blockers, *windows_provider_blockers]
    if required_ref != args.commit:
        blockers.append(f"required ref {args.require_ref} resolves to {required_ref}")
    if jobs:
        blockers.append("active or held Jobs exist other than the deployment Job")
    if any(not item["present"] or not item["usable"] for item in installed):
        blockers.append("one or more installed release artifacts are missing or unusable")
    return {
        "schemaVersion": SCHEMA_VERSION,
        "commit": args.commit,
        "sourceRepo": str(args.source_repo),
        "sourceHead": head,
        "sourceHeadMatchesCommit": head == args.commit,
        "requiredRef": args.require_ref,
        "requiredRefCommit": required_ref,
        "sourceClean": not bool(status),
        "activeJobIds": jobs,
        "ignoredCurrentJobId": ignored_current_job_id,
        "service": args.service,
        "candidate": candidate,
        "candidateManifest": candidate_manifest,
        "installed": installed,
        "windowsProvider": windows_provider,
        "eligible": not blockers,
        "blockers": blockers,
    }

def probe_mcp(
    env_file: Path,
    *,
    expected_tool_count: int | None,
    required: tuple[str, ...],
    wait_seconds: float,
    require_modern: bool,
    allow_legacy_fallback: bool,
) -> dict[str, object]:
    environment = load_environment_file(env_file)
    bind = environment.get("ORDIVON_BIND")
    if not bind:
        raise RuntimeError("environment file must define ORDIVON_BIND")
    token = load_bearer_token(environment)
    return probe_catalog(
        f"http://{bind}/mcp",
        token,
        client_name="ordivon-runtime-deploy",
        expected_tool_count=expected_tool_count,
        required_tools=required,
        wait_seconds=wait_seconds,
        require_modern=require_modern,
        allow_legacy_fallback=allow_legacy_fallback,
    )

def service_active(systemctl: Path, service: str) -> bool:
    return run([str(systemctl), "is-active", service], check=False).stdout.strip() == "active"


def wait_service_active(systemctl: Path, service: str, wait_seconds: float) -> None:
    deadline = time.monotonic() + wait_seconds
    while time.monotonic() < deadline:
        if service_active(systemctl, service):
            return
        time.sleep(0.2)
    raise RuntimeError(f"service did not become active: {service}")


def atomic_copy(source: Path, destination: Path, *, mode: int = 0o755) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_name(destination.name + f".tmp-{os.getpid()}")
    try:
        shutil.copy2(source, temporary)
        os.chmod(temporary, mode)
        with temporary.open("rb") as handle:
            os.fsync(handle.fileno())
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)


def write_json_atomic(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + f".tmp-{os.getpid()}")
    try:
        temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        with temporary.open("rb") as handle:
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+") as handle:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError(f"deployment lock is already held: {path}") from error
        yield


def admission_fence_path(database: Path) -> Path:
    return database.parent / "admission.lock"


def rollback_database(args: argparse.Namespace) -> Path:
    if args.database is not None:
        return args.database
    environment = load_environment_file(args.env_file)
    registry_root = environment.get("ORDIVON_REGISTRY_ROOT")
    if not registry_root:
        raise RuntimeError(
            "rollback requires --database or ORDIVON_REGISTRY_ROOT in the environment file"
        )
    root = Path(registry_root)
    if not root.is_absolute():
        raise RuntimeError("ORDIVON_REGISTRY_ROOT must be absolute for rollback")
    return root / "registry.sqlite3"


def acquire_exclusive_admission_fence(database: Path):
    path = admission_fence_path(database)
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = path.open("a+")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
    except Exception:
        handle.close()
        raise
    return handle


def wait_for_execution_drain(database: Path, timeout_seconds: float) -> list[str]:
    deadline = time.monotonic() + timeout_seconds
    while True:
        jobs, _ = active_job_ids(database)
        if not jobs:
            return []
        if time.monotonic() >= deadline:
            return jobs
        time.sleep(0.1)


@contextmanager
def fenced_execution_drain(database: Path, timeout_seconds: float):
    handle = acquire_exclusive_admission_fence(database)
    try:
        remaining_jobs = wait_for_execution_drain(database, timeout_seconds)
        if remaining_jobs:
            raise RuntimeError(
                "rollback drain timed out with active or held Jobs: "
                + ", ".join(remaining_jobs)
            )
        yield
    finally:
        handle.close()


def receipt_path(root: Path, commit: str) -> Path:
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    candidate = root / f"{stamp}-{commit[:12]}"
    suffix = 1
    while candidate.exists():
        candidate = root / f"{stamp}-{commit[:12]}-{suffix}"
        suffix += 1
    return candidate


def structured_release_effect(args: argparse.Namespace) -> dict[str, object] | None:
    values = (
        getattr(args, "effect_id", None),
        getattr(args, "effect_request_digest", None),
        getattr(args, "candidate_manifest_digest", None),
    )
    if all(value is None for value in values):
        return None
    if any(value is None for value in values):
        raise RuntimeError(
            "structured release requires effect-id, effect-request-digest, and candidate-manifest-digest together"
        )
    return {
        "contract": "runtime_release_v1",
        "effectId": values[0],
        "requestDigest": values[1],
        "commit": args.commit,
        "candidateManifestDigest": values[2],
        "sourceRepo": str(args.source_repo.resolve()),
        "candidateDir": str(args.candidate_dir.resolve()),
        "candidateManifest": str(args.candidate_manifest.resolve()),
        "installDir": str(args.install_dir.resolve()),
        "database": str(args.database.resolve()),
        "envFile": str(args.env_file.resolve()),
        "receiptRoot": str(args.receipt_root.resolve()),
        "service": args.service,
        "requiredRef": args.require_ref,
        "requiredTools": list(required_tools(args)),
        "expectedToolCount": args.expected_tool_count,
        "releaseArtifacts": [
            {
                "name": str(spec["name"]),
                "kind": str(spec["kind"]),
                "mode": int(spec["mode"]),
            }
            for spec in release_artifact_specs(args)
        ],
    }


def structured_receipt_path(root: Path, effect_id: str) -> Path:
    return root / f"effect-{effect_id}"


def existing_structured_release_result(
    receipt: Path, expected: dict[str, object]
) -> dict[str, object] | None:
    if not receipt.exists():
        return None
    if receipt.is_symlink() or not receipt.is_dir():
        raise RuntimeError("structured release receipt path is not a safe directory")
    request_path = receipt / "effect-request.json"
    if request_path.is_symlink() or not request_path.is_file():
        raise RuntimeError("structured release receipt lacks its effect request")
    recorded = json.loads(request_path.read_text(encoding="utf-8"))
    if recorded != expected:
        raise RuntimeError("effect-id is already bound to a different release request")
    result_path = receipt / "result.json"
    if not result_path.exists():
        raise RuntimeError(
            "structured release effect exists without a terminal result; reconcile it instead of repeating apply"
        )
    if result_path.is_symlink() or not result_path.is_file():
        raise RuntimeError("structured release terminal result is unsafe")
    result = json.loads(result_path.read_text(encoding="utf-8"))
    if not isinstance(result, dict):
        raise RuntimeError("structured release terminal result is invalid")
    release_effect = result.get("releaseEffect")
    if release_effect != expected:
        raise RuntimeError("structured release terminal result does not match its effect request")
    return {**result, "replayed": True}


def receipt_record_mode(record: dict[str, object]) -> int:
    mode = record.get("mode")
    if mode is None:
        # v1 receipts contained binaries only and installed them as 0755.
        return 0o755
    if not isinstance(mode, int) or not 0 <= mode <= 0o777:
        raise RuntimeError("deployment receipt contains an invalid artifact mode")
    return mode


def restore_previous(
    previous: Path,
    install_dir: Path,
    records: list[dict[str, object]],
    systemctl: Path,
    service: str,
    env_file: Path,
    wait_seconds: float,
    windows_provider: dict[str, object] | None = None,
) -> dict[str, object]:
    run([str(systemctl), "stop", service], check=False)
    for record in records:
        name = str(record.get("name", ""))
        if not name or name in {".", ".."} or "/" in name:
            raise RuntimeError("rollback receipt contains an invalid artifact name")
        source = previous / name
        if source.is_symlink() or not source.is_file():
            raise RuntimeError(f"rollback artifact is missing or unsafe: {source}")
        expected = record.get("digest")
        if isinstance(expected, str) and sha256(source) != expected:
            raise RuntimeError(f"rollback artifact digest does not match receipt: {name}")
        atomic_copy(source, install_dir / name, mode=receipt_record_mode(record))
    provider_restore = restore_windows_provider(env_file, windows_provider)
    run([str(systemctl), "start", service])
    wait_service_active(systemctl, service, wait_seconds)
    probe = probe_mcp(
        env_file,
        expected_tool_count=None,
        required=(),
        wait_seconds=wait_seconds,
        require_modern=False,
        allow_legacy_fallback=True,
    )
    return {"serviceActive": True, "probe": probe, "windowsProvider": provider_restore}

def prune_candidate_artifacts(
    candidate_dir: Path,
    deployment_root: Path,
    current_commit: str,
    *,
    keep: int = 2,
) -> dict[str, object]:
    candidate_commit_dir = candidate_dir.resolve().parent
    candidate_root = candidate_commit_dir.parent
    if (
        candidate_dir.name != "release"
        or candidate_commit_dir.name != current_commit
        or not candidate_root.is_dir()
    ):
        return {"status": "skipped", "reason": "nonstandard_candidate_layout", "actions": [], "failures": []}
    deployed: list[tuple[int, str]] = []
    for result_path in deployment_root.glob("*/result.json"):
        try:
            value = json.loads(result_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        commit = value.get("commit")
        finished = value.get("finishedAtMs")
        if value.get("status") == "deployed" and isinstance(commit, str) and COMMIT_PATTERN.fullmatch(commit) and isinstance(finished, int):
            deployed.append((finished, commit))
    preserved = {current_commit}
    for _, commit in sorted(deployed, reverse=True):
        preserved.add(commit)
        if len(preserved) >= keep:
            break
    actions: list[dict[str, object]] = []
    failures: list[dict[str, object]] = []
    for child in sorted(candidate_root.iterdir()):
        if not child.is_dir() or child.is_symlink() or not COMMIT_PATTERN.fullmatch(child.name) or child.name in preserved:
            continue
        try:
            byte_length = sum(
                item.lstat().st_size
                for item in child.rglob("*")
                if item.is_file() and not item.is_symlink()
            )
            shutil.rmtree(child)
            actions.append({"commit": child.name, "bytes": byte_length, "action": "candidate_removed"})
        except OSError as error:
            failures.append({"commit": child.name, "error": str(error)})
    return {
        "status": "completed" if not failures else "partial",
        "candidateRoot": str(candidate_root),
        "preservedCommits": sorted(preserved),
        "actions": actions,
        "failures": failures,
    }


def apply_deployment(args: argparse.Namespace) -> dict[str, object]:
    if args.confirm_commit != args.commit:
        raise RuntimeError("confirm-commit must exactly equal commit")
    release_effect = structured_release_effect(args)
    with exclusive_lock(args.lock_file):
        if release_effect is not None:
            receipt = structured_receipt_path(args.receipt_root, str(release_effect["effectId"]))
            replay = existing_structured_release_result(receipt, release_effect)
            if replay is not None:
                return replay
            receipt.mkdir(parents=True, exist_ok=False)
            write_json_atomic(receipt / "effect-request.json", release_effect)
        else:
            receipt = receipt_path(args.receipt_root, args.commit)

        try:
            initial_plan = deployment_plan(args)
            non_job_blockers = [
                blocker
                for blocker in initial_plan["blockers"]
                if blocker != "active or held Jobs exist other than the deployment Job"
            ]
            if non_job_blockers:
                raise RuntimeError("deployment is not eligible: " + "; ".join(non_job_blockers))
        except Exception as setup_error:
            if release_effect is not None:
                write_json_atomic(
                    receipt / "result.json",
                    {
                        "schemaVersion": SCHEMA_VERSION,
                        "status": "not_committed",
                        "commit": args.commit,
                        "finishedAtMs": int(time.time() * 1000),
                        "deploymentError": str(setup_error),
                        "receipt": str(receipt),
                        "releaseEffect": release_effect,
                    },
                )
            raise

        plan = initial_plan
        specs = release_artifact_specs(args)
        previous = receipt / "previous"
        previous.mkdir(parents=True)
        installed_by_name = {str(item["name"]): item for item in plan["installed"]}
        previous_commit = matching_release_commit(args.receipt_root, plan["installed"])
        previous_records: list[dict[str, object]] = []
        commit_started = False
        stopped = False
        admission_fence_handle = None
        try:
            for spec in specs:
                name = str(spec["name"])
                installed = installed_by_name[name]
                previous_mode = installed.get("mode")
                if not isinstance(previous_mode, int):
                    raise RuntimeError(f"installed release artifact has no mode: {name}")
                atomic_copy(args.install_dir / name, previous / name, mode=previous_mode)
                atomic_copy(
                    args.candidate_dir / name,
                    args.install_dir / f"{name}.next",
                    mode=int(spec["mode"]),
                )
                previous_records.append(
                    artifact_description(
                        previous / name,
                        {"name": name, "kind": spec["kind"], "mode": previous_mode},
                    )
                )
            write_json_atomic(
                receipt / "manifest.json",
                {
                    "schemaVersion": SCHEMA_VERSION,
                    "commit": args.commit,
                    "service": args.service,
                    "artifacts": [
                        {
                            "name": str(spec["name"]),
                            "kind": str(spec["kind"]),
                            "mode": int(spec["mode"]),
                        }
                        for spec in specs
                    ],
                    "binaries": list(binaries(args)),
                    "previousCommit": previous_commit,
                    "installDir": str(args.install_dir),
                    "envFile": str(args.env_file),
                    "previous": previous_records,
                    "candidate": plan["candidate"],
                    "windowsProvider": plan.get("windowsProvider"),
                    "releaseEffect": release_effect,
                },
            )
            admission_fence_handle = acquire_exclusive_admission_fence(args.database)
            remaining_jobs = wait_for_execution_drain(args.database, args.drain_seconds)
            if remaining_jobs:
                raise RuntimeError(
                    "deployment drain timed out with active or held Jobs: "
                    + ", ".join(remaining_jobs)
                )
            # Stop ingress immediately after the Registry first reaches zero. This ordering is
            # required for the one-time bootstrap from a Runtime that does not yet participate in
            # admission.lock; doing full candidate/ref revalidation before stop would reopen the
            # plan→apply race we are trying to remove. Future fenced Runtimes cannot admit here.
            run([str(args.systemctl), "stop", args.service])
            stopped = True
            race_jobs, _ = active_job_ids(args.database)
            if race_jobs:
                raise RuntimeError(
                    "active or held Jobs appeared after service stop: "
                    + ", ".join(race_jobs)
                )
            plan = deployment_plan(args)
            if not plan["eligible"]:
                raise RuntimeError(
                    "deployment is not eligible after ingress stop: "
                    + "; ".join(plan["blockers"])
                )
            plan["admissionFence"] = str(admission_fence_path(args.database))
            plan["drainSeconds"] = args.drain_seconds
            write_json_atomic(receipt / "plan.json", plan)
            for record in previous_records:
                name = str(record["name"])
                atomic_copy(
                    previous / name,
                    args.install_dir / f"{name}.previous",
                    mode=int(record["mode"]),
                )
            commit_started = True
            installed_windows_provider = install_windows_provider(
                args, plan.get("windowsProvider") if isinstance(plan, dict) else None
            )
            for spec in specs:
                name = str(spec["name"])
                os.replace(args.install_dir / f"{name}.next", args.install_dir / name)
            run([str(args.systemctl), "start", args.service])
            wait_service_active(args.systemctl, args.service, args.wait_seconds)
            probe = probe_mcp(
                args.env_file,
                expected_tool_count=args.expected_tool_count,
                required=required_tools(args),
                wait_seconds=args.wait_seconds,
                require_modern=True,
                allow_legacy_fallback=False,
            )
            installed = [
                artifact_description(args.install_dir / str(spec["name"]), spec)
                for spec in specs
            ]
            candidate_prune = prune_candidate_artifacts(
                args.candidate_dir,
                args.receipt_root,
                args.commit,
            )
            result = {
                "schemaVersion": SCHEMA_VERSION,
                "status": "deployed",
                "commit": args.commit,
                "finishedAtMs": int(time.time() * 1000),
                "serviceActive": True,
                "probe": probe,
                "installed": installed,
                "windowsProvider": installed_windows_provider,
                "candidatePrune": candidate_prune,
                "receipt": str(receipt),
                "releaseEffect": release_effect,
            }
            write_json_atomic(receipt / "result.json", result)
            return result
        except Exception as deployment_error:
            for spec in specs:
                name = str(spec["name"])
                (args.install_dir / f"{name}.next").unlink(missing_ok=True)
            rollback_error: Exception | None = None
            if commit_started:
                try:
                    rollback = restore_previous(
                        previous,
                        args.install_dir,
                        previous_records,
                        args.systemctl,
                        args.service,
                        args.env_file,
                        args.wait_seconds,
                        plan.get("windowsProvider") if isinstance(plan, dict) else None,
                    )
                except Exception as error:
                    rollback_error = error
                    rollback = {"serviceActive": service_active(args.systemctl, args.service)}
                status = "rolled_back" if rollback_error is None else "rollback_failed"
            else:
                recovery_error: Exception | None = None
                recovery: dict[str, object] | None = None
                if stopped or not service_active(args.systemctl, args.service):
                    try:
                        run([str(args.systemctl), "start", args.service])
                        wait_service_active(args.systemctl, args.service, args.wait_seconds)
                        recovery = {
                            "serviceActive": True,
                            "probe": probe_mcp(
                                args.env_file,
                                expected_tool_count=args.expected_tool_count,
                                required=required_tools(args),
                                wait_seconds=args.wait_seconds,
                                require_modern=False,
                                allow_legacy_fallback=True,
                            ),
                        }
                    except Exception as error:
                        recovery_error = error
                        recovery = {
                            "serviceActive": service_active(args.systemctl, args.service)
                        }
                rollback = recovery
                rollback_error = recovery_error
                status = "not_committed" if recovery_error is None else "recovery_failed"
            result = {
                "schemaVersion": SCHEMA_VERSION,
                "status": status,
                "commit": args.commit,
                "finishedAtMs": int(time.time() * 1000),
                "deploymentError": str(deployment_error),
                "rollbackError": str(rollback_error) if rollback_error else None,
                "rollback": rollback,
                "serviceWasStopped": stopped,
                "receipt": str(receipt),
                "releaseEffect": release_effect,
            }
            write_json_atomic(receipt / "result.json", result)
            raise RuntimeError(
                f"deployment failed and {status}: {deployment_error}"
                + (f"; rollback: {rollback_error}" if rollback_error else "")
            ) from deployment_error
        finally:
            if admission_fence_handle is not None:
                admission_fence_handle.close()

def rollback_deployment(args: argparse.Namespace) -> dict[str, object]:
    receipt = args.receipt.resolve()
    if args.confirm_receipt.resolve() != receipt:
        raise RuntimeError("confirm-receipt must exactly equal receipt")
    manifest = json.loads((receipt / "manifest.json").read_text(encoding="utf-8"))
    version = manifest.get("schemaVersion")
    if version not in {*LEGACY_SCHEMA_VERSIONS, SCHEMA_VERSION}:
        raise RuntimeError("deployment receipt schemaVersion is unsupported")
    if version >= 2:
        raw_artifacts = manifest.get("artifacts")
        if not isinstance(raw_artifacts, list) or not raw_artifacts:
            raise RuntimeError("deployment receipt has no release artifacts")
        names = tuple(
            str(item.get("name")) for item in raw_artifacts if isinstance(item, dict)
        )
    else:
        names = tuple(str(name) for name in manifest.get("binaries", []))
    if not names or len(names) != len(set(names)):
        raise RuntimeError("deployment receipt has an invalid artifact set")
    if manifest.get("installDir") != str(args.install_dir):
        raise RuntimeError("install-dir does not match the deployment receipt")
    if manifest.get("service") != args.service:
        raise RuntimeError("service does not match the deployment receipt")
    if manifest.get("envFile") != str(args.env_file):
        raise RuntimeError("env-file does not match the deployment receipt")
    windows_provider = manifest.get("windowsProvider") if version >= 3 else None
    previous_records = [
        item for item in manifest.get("previous", []) if isinstance(item, dict)
    ]
    previous_by_name = {str(item.get("name")): item for item in previous_records}
    if set(previous_by_name) != set(names):
        raise RuntimeError("deployment receipt previous-artifact set is incomplete")
    for name in names:
        previous = receipt / "previous" / name
        expected = previous_by_name[name].get("digest")
        if not isinstance(expected, str) or sha256(previous) != expected:
            raise RuntimeError(f"previous artifact digest does not match receipt: {name}")
        receipt_record_mode(previous_by_name[name])
    database = rollback_database(args)
    with exclusive_lock(args.lock_file), fenced_execution_drain(database, args.drain_seconds):
        current = receipt / f"rollback-current-{int(time.time() * 1000)}"
        current.mkdir()
        current_records: list[dict[str, object]] = []
        for name in names:
            path = args.install_dir / name
            if path.is_symlink() or not path.is_file():
                raise RuntimeError(f"current release artifact is missing or unsafe: {path}")
            mode = stat.S_IMODE(path.stat().st_mode)
            kind = str(previous_by_name[name].get("kind", "binary"))
            atomic_copy(path, current / name, mode=mode)
            current_records.append(
                artifact_description(
                    current / name,
                    {"name": name, "kind": kind, "mode": mode},
                )
            )
        try:
            outcome = restore_previous(
                receipt / "previous",
                args.install_dir,
                previous_records,
                args.systemctl,
                args.service,
                args.env_file,
                args.wait_seconds,
                windows_provider,
            )
        except Exception as rollback_error:
            current_restore_error: Exception | None = None
            try:
                current_outcome = restore_previous(
                    current,
                    args.install_dir,
                    current_records,
                    args.systemctl,
                    args.service,
                    args.env_file,
                    args.wait_seconds,
                    inverse_windows_provider_record(windows_provider),
                )
            except Exception as error:
                current_restore_error = error
                current_outcome = {"serviceActive": service_active(args.systemctl, args.service)}
            failed = {
                "schemaVersion": SCHEMA_VERSION,
                "status": (
                    "rollback_failed_current_restored"
                    if current_restore_error is None
                    else "rollback_failed_current_restore_failed"
                ),
                "receipt": str(receipt),
                "finishedAtMs": int(time.time() * 1000),
                "rollbackError": str(rollback_error),
                "currentRestoreError": str(current_restore_error) if current_restore_error else None,
                "currentBackup": str(current),
                "currentRestore": current_outcome,
            }
            write_json_atomic(receipt / "rollback-result.json", failed)
            raise RuntimeError(
                f"explicit rollback failed: {rollback_error}"
                + (
                    f"; current restore also failed: {current_restore_error}"
                    if current_restore_error
                    else "; current deployment was restored"
                )
            ) from rollback_error
        restored_records = [
            artifact_description(
                args.install_dir / name,
                {
                    "name": name,
                    "kind": str(previous_by_name[name].get("kind", "binary")),
                    "mode": receipt_record_mode(previous_by_name[name]),
                },
            )
            for name in names
        ]
        previous_commit = manifest.get("previousCommit")
        if not isinstance(previous_commit, str) or not COMMIT_PATTERN.fullmatch(previous_commit):
            previous_commit = None
        result = {
            "schemaVersion": SCHEMA_VERSION,
            "status": "restored_previous",
            "releaseDisposition": "rollback",
            "commit": previous_commit,
            "commitKnown": previous_commit is not None,
            "receipt": str(receipt),
            "finishedAtMs": int(time.time() * 1000),
            "currentBackup": str(current),
            "installed": restored_records,
            **outcome,
        }
        write_json_atomic(receipt / "rollback-result.json", result)
        return result

def main() -> int:
    try:
        args = parse_args()
        if args.command == "prepare":
            value = prepare_candidate(args)
            print(json.dumps(value, indent=2 if args.pretty else None, sort_keys=args.pretty))
            return 0
        if args.command == "plan":
            value = deployment_plan(args)
            print(json.dumps(value, indent=2 if args.pretty else None, sort_keys=args.pretty))
            return 0 if value["eligible"] else 2
        if args.command == "apply":
            print(json.dumps(apply_deployment(args), sort_keys=True))
            return 0
        if args.command == "rollback":
            print(json.dumps(rollback_deployment(args), sort_keys=True))
            return 0
        raise RuntimeError(f"unsupported command: {args.command}")
    except (OSError, RuntimeError, sqlite3.Error, json.JSONDecodeError) as error:
        print(f"runtime deployment failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
