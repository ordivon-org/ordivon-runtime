{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.local/schemas/evidence-envelope-v1.schema.json",
  "title": "Ordivon Evidence Envelope v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "phase",
    "evidenceType",
    "generatedAt",
    "sourceRevision",
    "implementationCommit",
    "harnesses",
    "environment",
    "observationsDigest",
    "claimsNotMade"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "phase": {"type": "string", "minLength": 1},
    "evidenceType": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementationCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "harnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "environment": {"type": "object"},
    "observationsDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "claimsNotMade": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
