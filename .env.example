# Ordivon local MCP runtime.
# ORDIVON_M7_* names are transitional and will be removed when the entry point is unified.

RUST_LOG=info

# Required for both modes
# ORDIVON_M7_BIND=127.0.0.1:8897
# ORDIVON_M7_BEARER_TOKEN=<random value with at least 32 characters>
# ORDIVON_M7_STORE_ROOT=/var/lib/ordivon/runtime
# ORDIVON_M7_REGISTRY_ROOT=/var/lib/ordivon/registry
# ORDIVON_M7_RUNNER_PATH=/path/to/ordivon-task-runner
# ORDIVON_M7_ALLOWED_EXECUTABLE_ROOTS=/usr/bin:/usr/local/bin

# Default: trusted-local
# Uses the current user and ordinary Git rollback. It keeps cgroup ownership,
# timeout, bounded output, cancellation, Job/Attempt truth, and reconciliation.
# ORDIVON_M7_EXECUTION_MODE=trusted-local

# Optional isolated mode for unknown repositories or untrusted scripts.
# ORDIVON_M7_EXECUTION_MODE=isolated
# ORDIVON_M7_CONTROL_ROOT=/var/lib/ordivon/control
# ORDIVON_M7_WORKER_ROOT=/var/lib/ordivon/worker
# ORDIVON_M7_CACHE_ROOT=/var/cache/ordivon-worker
# ORDIVON_M7_RUNTIME_VIEW_ROOT=/run/ordivon
# ORDIVON_M7_WORKER_UID=<ordivon-worker uid>
# ORDIVON_M7_WORKER_GID=<ordivon-worker gid>

# Optional limits
# ORDIVON_M7_BODY_LIMIT_BYTES=1048576
# ORDIVON_M7_BUSY_TIMEOUT_MS=5000
# ORDIVON_M7_STARTUP_GRACE_MS=2000
# ORDIVON_M7_TRACE_PATH=/var/lib/ordivon/registry/runtime-trace.jsonl
