# Ordivon local MCP runtime.

RUST_LOG=info

# Required
# ORDIVON_BIND=127.0.0.1:8897
# ORDIVON_BEARER_TOKEN=<random value with at least 32 characters>
# ORDIVON_STORE_ROOT=/var/lib/ordivon/runtime
# ORDIVON_REGISTRY_ROOT=/var/lib/ordivon/registry
# ORDIVON_RUNNER_PATH=/path/to/ordivon-task-runner
# ORDIVON_ALLOWED_EXECUTABLE_ROOTS=/usr/bin:/usr/local/bin

# Default: trusted-local
# Uses the current user and ordinary Git rollback. It keeps cgroup ownership,
# timeout, bounded output, cancellation, Job/Attempt truth, and reconciliation.
# ORDIVON_EXECUTION_MODE=trusted-local

# Optional isolated mode for unknown repositories or untrusted scripts.
# ORDIVON_EXECUTION_MODE=isolated
# ORDIVON_CONTROL_ROOT=/var/lib/ordivon/control
# ORDIVON_WORKER_ROOT=/var/lib/ordivon/worker
# ORDIVON_CACHE_ROOT=/var/cache/ordivon-worker
# ORDIVON_RUNTIME_VIEW_ROOT=/run/ordivon
# ORDIVON_WORKER_UID=<ordivon-worker uid>
# ORDIVON_WORKER_GID=<ordivon-worker gid>

# Optional limits
# ORDIVON_BODY_LIMIT_BYTES=1048576
# ORDIVON_BUSY_TIMEOUT_MS=5000
# ORDIVON_STARTUP_GRACE_MS=2000
# ORDIVON_TRACE_PATH=/var/lib/ordivon/registry/runtime-trace.jsonl
