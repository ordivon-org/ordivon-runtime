# Ordivon local runtime examples.
# Versioned M-series variables remain only until the runtime entry points are unified.

RUST_LOG=info

# Current hardened local HTTP surface
# ORDIVON_M7_BIND=127.0.0.1:0
# ORDIVON_M7_BEARER_TOKEN=<random value with at least 32 characters>
# ORDIVON_M7_STORE_ROOT=/var/lib/ordivon/worker/workspaces
# ORDIVON_M7_REGISTRY_ROOT=/var/lib/ordivon/control/registry
# ORDIVON_M7_RUNNER_PATH=/path/to/ordivon-task-runner
# ORDIVON_M7_ALLOWED_EXECUTABLE_ROOTS=/usr/bin:/usr/local/bin
# ORDIVON_M7_CONTROL_ROOT=/var/lib/ordivon/control
# ORDIVON_M7_WORKER_ROOT=/var/lib/ordivon/worker
# ORDIVON_M7_CACHE_ROOT=/var/cache/ordivon-worker
# ORDIVON_M7_RUNTIME_VIEW_ROOT=/run/ordivon
# ORDIVON_M7_WORKER_UID=<ordivon-worker uid>
# ORDIVON_M7_WORKER_GID=<ordivon-worker gid>
