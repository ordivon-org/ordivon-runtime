RUST_LOG=ordivon_runtime_mcp=info,rmcp=warn
ORDIVON_BIND=127.0.0.1:8897
ORDIVON_BEARER_TOKEN_FILE=/etc/ordivon/runtime-mcp.token
# Optional credential for a dedicated public Tunnel hostname that intentionally bypasses Access.
# Never reuse runtime-mcp.token here. The remote token is stored by an approved hosted MCP client and carries full Runtime authority.
# ORDIVON_REMOTE_BEARER_TOKEN_FILE=/etc/ordivon/runtime-remote-mcp.token
# Remote OAuth auth is independently opt-in. Cloudflare Access Managed OAuth terminates at the edge; Runtime validates the signed origin assertion.
# ORDIVON_TRUST_CF_ACCESS is retained as the rollback-compatible enable flag; it no longer means trusting header presence.
ORDIVON_TRUST_CF_ACCESS=false
# When enabling Access auth, set both values below from the exact Access application.
# ORDIVON_CF_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
# ORDIVON_CF_ACCESS_AUDIENCE=<access-application-aud>
# Optional override; defaults to ${ORDIVON_CF_ACCESS_ISSUER}/cdn-cgi/access/certs.
# ORDIVON_CF_ACCESS_JWKS_URL=https://<team>.cloudflareaccess.com/cdn-cgi/access/certs
ORDIVON_STORE_ROOT=/var/lib/ordivon/runtime
ORDIVON_REGISTRY_ROOT=/var/lib/ordivon/registry
ORDIVON_RUNNER_PATH=/usr/local/libexec/ordivon/ordivon-runtime-runner
# Optional experimental Windows-native target; configure both or neither. The launcher is an exact WSL-visible Windows executable.
# ORDIVON_WINDOWS_LAUNCHER_PATH=/mnt/c/ProgramData/Ordivon/ordivon-windows-job-launcher.exe
# ORDIVON_WINDOWS_WSL_DISTRIBUTION=archlinux
ORDIVON_PRINCIPAL=principal:local-owner
ORDIVON_EXEC_HOME=/root
# Explicit target-process PATH; add trusted local toolchain roots here rather than inheriting service state.
ORDIVON_EXEC_PATH=/root/.local/bin:/root/.local/share/mise/shims:/root/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
ORDIVON_GLOBAL_MAX_CONCURRENCY=8
# Optional restriction. Omit to allow every canonical executable path in trusted-local.
# ORDIVON_ALLOWED_EXECUTABLE_ROOTS=/usr/bin:/usr/local/bin
# Optional operator-owned roots for workspace.execBound. Callers receive authority names only, never host source paths.
# ORDIVON_INPUT_AUTHORITIES_JSON=[{"name":"finance-prepared","root":"/var/lib/ordivon/inputs/finance-prepared"}]
ORDIVON_BODY_LIMIT_BYTES=1048576
# Server ceiling; each Job may request a smaller timeout.
ORDIVON_MAX_RUNTIME_MS=3600000
# Maximum retained bytes for each stdout/stderr stream; callers may request less.
ORDIVON_MAX_OUTPUT_BYTES=16777216
ORDIVON_CACHE_HIGH_WATERMARK_BYTES=68719476736
ORDIVON_CACHE_LOW_WATERMARK_BYTES=51539607552
ORDIVON_BUSY_TIMEOUT_MS=5000
ORDIVON_STARTUP_GRACE_MS=2000
ORDIVON_RECONCILE_INTERVAL_MS=15000
ORDIVON_RECONCILE_BATCH_SIZE=32
ORDIVON_TRACE_PATH=/var/lib/ordivon/registry/runtime-trace.jsonl
# Target processes receive an explicit minimal environment. Request env overrides the defaults.
# trusted_local shares package caches globally and Cargo target data by canonical source repository.
# contained_local keeps package/build caches Workspace-scoped; disposable Workspace caches are removed on close.
