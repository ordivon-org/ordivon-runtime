[Unit]
Description=Ordivon Runtime lifecycle maintenance
After=ordivon-runtime.service
Requires=ordivon-runtime.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/ordivon/ordivon-runtime-lifecycle sweep --database /var/lib/ordivon/registry/registry.sqlite3 --runtime-store-root /var/lib/ordivon/runtime --policy-file /etc/ordivon/workspace-retention.json --env-file /etc/ordivon/ordivon-runtime.env --receipt-root /var/lib/ordivon/runtime/lifecycle-receipts --lock-file /run/ordivon-runtime-lifecycle.lock --measure-bytes --confirm-policy APPLY_WORKSPACE_RETENTION_POLICY
ExecStart=/usr/local/libexec/ordivon/ordivon-runtime-cache prune --database /var/lib/ordivon/registry/registry.sqlite3 --registry-root /var/lib/ordivon/registry --runtime-store-root /var/lib/ordivon/runtime --receipt-root /var/lib/ordivon/runtime/cache-receipts --lock-file /run/ordivon-runtime-cache.lock --env-file /etc/ordivon/ordivon-runtime.env --confirm-policy PRUNE_EXECUTION_CACHES
