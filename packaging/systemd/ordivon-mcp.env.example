RUST_LOG=ordivon_mcp=info,rmcp=warn
ORDIVON_BIND=127.0.0.1:8897
ORDIVON_BEARER_TOKEN=<replace-with-at-least-32-random-characters>
ORDIVON_STORE_ROOT=/var/lib/ordivon/runtime
ORDIVON_REGISTRY_ROOT=/var/lib/ordivon/registry
ORDIVON_RUNNER_PATH=/usr/local/libexec/ordivon/ordivon-task-runner
ORDIVON_EXECUTION_MODE=trusted-local
ORDIVON_PRINCIPAL=principal:local-owner
ORDIVON_GLOBAL_MAX_CONCURRENCY=4
# Optional restriction. Omit to allow every canonical executable path in trusted-local.
# ORDIVON_ALLOWED_EXECUTABLE_ROOTS=/usr/bin:/usr/local/bin
ORDIVON_BODY_LIMIT_BYTES=1048576
ORDIVON_BUSY_TIMEOUT_MS=5000
ORDIVON_STARTUP_GRACE_MS=2000
ORDIVON_TRACE_PATH=/var/lib/ordivon/registry/runtime-trace.jsonl
